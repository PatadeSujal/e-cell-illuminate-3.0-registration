# Google Sheets (service account) — required for storing registrations
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-google-sheet-id

# UPI payment details used to generate the QR code (public — safe to expose to the browser)
NEXT_PUBLIC_UPI_ID=ecell-wadia@upi
NEXT_PUBLIC_UPI_PAYEE_NAME=ECELL Wadia

# Google Sheets Webhook (Alternative to Service Account)
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
